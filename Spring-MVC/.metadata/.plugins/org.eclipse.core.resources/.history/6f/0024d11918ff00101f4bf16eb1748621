<%@page import="com.rays.dto.UserDTO"%>
<%@ page isELIgnored="false"%>
<%@taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@taglib uri="http://tiles.apache.org/tags-tiles" prefix="tiles"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>My Application</title>
</head>
<body>

<!-- Header -->
<c:choose>
    <c:when test="${not empty sessionScope.user}">
        <h3>Hi, <c:out value="${sessionScope.user.firstName}"/></h3>
        <a href="<c:url value='/ctl/User'/>"><b>Add User</b></a> |
        <a href="<c:url value='/ctl/User/search'/>"><b>User List</b></a> |
        <a href="<c:url value='/Login?operation=logout'/>"><b>Logout</b></a>
    </c:when>
    <c:otherwise>
        <h3>Hi, Guest</h3>
    </c:otherwise>
</c:choose>

<hr>

<!-- BODY PLACEHOLDER -->
<tiles:insertAttribute name="body" />

<!-- Footer -->
<hr>
<p>Footer content here</p>

</body>
</html>
